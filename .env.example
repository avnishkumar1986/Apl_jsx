APP_NAME="Apollo Pipes"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
API_ENVIRONMENT=production
EMPLOYEE_API_URL=
EMPLOYEE_API_USERNAME=
EMPLOYEE_API_PASSWORD=
MATERIAL_API_ENDPOINT=
STOCK_API_ENDPOINT=
VENDOR_API_ENDPOINT=
SECURITY_AUDIT_BASE_URL=http://127.0.0.1:8001
SECURITY_AUDIT_ENDPOINT=/api/security-audits/run
SECURITY_AUDIT_USERNAME=
SECURITY_AUDIT_PASSWORD=
API_ALLOWED_HOSTS=
API_INSECURE_TLS_HOSTS=
API_AUTH_USERNAME=
API_AUTH_PASSWORD=
PRODUCTION_API_USERNAME=
PRODUCTION_API_PASSWORD=
PROCUREMENT_STOCK_API_TOKEN=
QUALITY_API_TOKEN=
PRODUCTION_API_TOKEN=

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=apollopipes.com
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"
MICROSOFT_ALLOWED_DOMAIN=apollopipes.com

DATATABLE_PER_PAGE=50
DATATABLE_PAGE_SIZE_OPTIONS=50,100
SMS_OTP_WEBHOOK_URL=
SMS_OTP_WEBHOOK_TOKEN=
SMS_OTP_SENDER=
